<queryFilter xmlns="https://admin-shell.io/aas/3/2">
  <fragment>$sme.prop#value</fragment>
  <condition>
    <lessThanOrEqualComparison>
      <le>
        <hexLiteral>
          <hexVal>16#1</hexVal>
        </hexLiteral>
        <hexLiteral>
          <hexVal>16#1F</hexVal>
        </hexLiteral>
      </le>
    </lessThanOrEqualComparison>
  </condition>
</queryFilter>
